# Copy thành .env.local và điền giá trị từ Supabase Dashboard → Project Settings → API.
# Chỉ dùng publishable/anon key. KHÔNG bao giờ đưa service_role / secret key vào app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# ── Chatbot AI ──────────────────────────────────────────────────────────────
# Hỗ trợ bất kỳ API tương thích OpenAI Chat Completions.
# Ví dụ OpenAI:   https://api.openai.com/v1/chat/completions
# Ví dụ Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Ví dụ Groq:     https://api.groq.com/openai/v1/chat/completions
EXPO_PUBLIC_CHATBOT_API_URL=
EXPO_PUBLIC_CHATBOT_API_KEY=
EXPO_PUBLIC_CHATBOT_MODEL=gpt-4o-mini
